# ==================== Application ====================
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
METADATA_DB_PATH=./data/metadata.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=true

# ==================== Qdrant ====================
# local: embedded local storage, no Docker or API key required
# remote: independent Qdrant service configured by QDRANT_URL
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Used only by docker-compose.yml
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ==================== Embedding ====================
# local uses the built-in deterministic hashing model and requires no key.
# openai uses an OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=hashing-multilingual-v1
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64

# ==================== LLM ====================
# Leaving the primary empty and the optional secondary disabled keeps the
# application in offline extractive mode. Any OpenAI-compatible provider works.
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90

# Optional secondary OpenAI-compatible LLM. The backend tries it only when the
# primary request fails; if both providers fail, it returns an extractive answer.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
LLM_FALLBACK_MODEL=qwen3:4b-instruct
LLM_FALLBACK_TIMEOUT_SECONDS=180

# ==================== Ingestion and retrieval ====================
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
LEXICAL_SCAN_LIMIT=5000
MAX_CONTEXT_CHARS=14000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1000
